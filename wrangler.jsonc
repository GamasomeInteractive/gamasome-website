{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamasome-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  // nodejs_compat lets the Node `fs`/`path` based code (contentlayer, content
  // readers) run on Workers. global_fetch_strictly_public is required by OpenNext.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // To enable ISR / on-demand revalidation later, add an R2 bucket binding here
  // and switch open-next.config.ts to the r2-incremental-cache override.
}
